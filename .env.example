# ==============================================================================
# Lumen Chat Environment Variables (Server-Side Only — NEVER expose to browser)
# ==============================================================================

# Required for AI Chat, Reasoning, Vision/PDF Analysis, and Paid Gemini Image Gen
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Image Generation Provider Configuration
# Supported values:
#   auto         - Uses HUGGINGFACE_API_KEY / OPENAI_API_KEY / POLLINATIONS_API_KEY if set;
#                  otherwise tries Gemini Image (if billing enabled) and falls back to free Pollinations FLUX.
#   gemini       - Always use Gemini image model (requires billing enabled on GEMINI_API_KEY)
#   huggingface  - Use Hugging Face Serverless Inference (free tier with HUGGINGFACE_API_KEY)
#   openai       - Use OpenAI or any OpenAI-compatible Images API
#   pollinations - Use Pollinations FLUX (keyless free tier: ~1 image / 45s per IP, or unlimited with key)
IMAGE_PROVIDER="auto"

# Optional Model Overrides per Provider
GEMINI_IMAGE_MODEL="gemini-3.1-flash-lite-image"
HUGGINGFACE_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"
OPENAI_IMAGE_MODEL="gpt-image-1"
OPENAI_IMAGE_BASE_URL="https://api.openai.com/v1"
POLLINATIONS_IMAGE_MODEL="flux"

# Optional Alternative Image Provider Keys (set one in Vercel for higher free/paid image limits)
# HUGGINGFACE_API_KEY=""
# POLLINATIONS_API_KEY=""
# OPENAI_API_KEY=""

# Optional App URL (used for deployment metadata)
APP_URL="MY_APP_URL"
